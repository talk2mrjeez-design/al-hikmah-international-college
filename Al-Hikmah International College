<script>

function searchSite() {

    const query =
        document.getElementById("siteSearch")
        .value
        .trim()
        .toLowerCase();

    if (!query) {

        alert("Please enter something to search.");

        return;

    }

    const pages = [

        {
            name: "About Us",
            url: "about.html",
            keywords: "about history mission vision values"
        },

        {
            name: "Academics",
            url: "academics.html",
            keywords: "subjects science arts commercial classes"
        },

        {
            name: "Admission",
            url: "admission.html",
            keywords: "admission application apply"
        },

        {
            name: "Gallery",
            url: "gallery.html",
            keywords: "photos pictures school gallery"
        },

        {
            name: "Staff",
            url: "staff.html",
            keywords: "principal teachers staff"
        },

        {
            name: "Fees",
            url: "fees.html",
            keywords: "fees tuition payment school fees"
        },

        {
            name: "FAQ",
            url: "faq.html",
            keywords: "questions answers faq"
        },

        {
            name: "Contact",
            url: "contact.html",
            keywords: "phone whatsapp email address contact"
        }

    ];

    const result = pages.find(page =>
        page.name.toLowerCase().includes(query) ||
        page.keywords.includes(query)
    );

    if (result) {

        window.location.href = result.url;

    } else {

        alert("No matching page was found.");

    }

}

</script>
